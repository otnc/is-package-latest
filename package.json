{
  "name": "is-package-latest",
  "version": "3.1.0",
  "description": "Check if a package is the latest version.",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "exports": {
    "import": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "require": {
      "types": "./dist/index.d.cts",
      "default": "./dist/index.cjs"
    }
  },
  "types": "dist/index.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "test": "vitest run",
    "format": "prettier --write ./src/",
    "format:check": "prettier --check ./src/",
    "typecheck": "tsc --noEmit",
    "build": "tsdown"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/otnc/is-package-latest.git"
  },
  "keywords": [
    "update",
    "check",
    "package",
    "version"
  ],
  "author": "otoneko.",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/otnc/is-package-latest/issues"
  },
  "homepage": "https://github.com/otnc/is-package-latest#readme",
  "dependencies": {
    "ofetch": "^1.5.1",
    "semver": "^7.7.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/semver": "^7.7.1",
    "prettier": "^3.8.1",
    "tsdown": "^0.22.13",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
